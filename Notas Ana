programa
{
	
	funcao inicio()
	{
		cadeia a[3]
		inteiro n[3] [2]

		para (inteiro i = 0; i < 3; i++)
		{
		 escreva("Por favor escreva o nome dos alunos: \n")
		 leia(a[i])
		}
		 para (inteiro j = 0; j < 3; j++)
		 {
		 	para (inteiro k = 0; k < 2; k++)
               {
               	escreva("Por favor digite as notas dos alunos em ordem: \n")
               	leia(n[j] [k])
               }
		 }
		 para (inteiro i = 0; i < 3; i++)
		 {
		 	para (inteiro j = 0; j < 3; j++)
		 	{
		 		para (inteiro k = 0; k < 2; k++)
		 		{
		 			escreva(a[i], "\n")
		 			escreva(n[j] [k], "\t \n")
		 		}
		 	}
		 }
	}
}
