programa
{
	
	funcao inicio()
	{
		inteiro m[3] [3]

		para (inteiro i = 0; i < 3; i++)
		{
			
			para (inteiro j = 0; j < 3; j++)
                {
			escreva("Escreva o valor desejado: \n")
			leia(m[i] [j])
                }
		}  
           para (inteiro i = 0; i < 3; i++)
		{
			para (inteiro j = 0; j < 3; j++)
                {
                 se (i == j) 
                  escreva(m[i] [j], "\t")
                }
                escreva("\n")
		}
	}
}
